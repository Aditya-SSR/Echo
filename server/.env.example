# Copy this file to server/.env and fill in the values. Never commit .env.

# MongoDB Atlas -> Database -> Connect -> Drivers -> copy the connection string
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/echo?retryWrites=true&w=majority

# Any long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where the frontend runs (used for Google sign-in redirects and CORS)
FRONTEND_URL=http://localhost:3000

# Optional - extra origins allowed to call the API, comma-separated
# (e.g. https://echo.vercel.app,capacitor://localhost). Not needed for native apps.
ALLOWED_ORIGINS=

# Optional - Google sign-in is disabled if these are empty.
# Google Cloud Console -> APIs & Services -> Credentials (OAuth client).
# Authorised redirect URI: <backend-url>/users/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional - Render sets this itself in production.
PORT=8000
